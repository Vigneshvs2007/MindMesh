# Research Pilot / ScholarPilot MCP Server
# Local embeddings by default (free, no API key needed)
# Add API keys for Semantic Scholar, GitHub, Overleaf, or OpenAI as needed

# Core
NODE_ENV=production
LOG_LEVEL=info

# Semantic Scholar API (free tier: 100 req/5min, API key recommended for higher limits)
# Get key at: https://www.semanticscholar.org/product/api
SEMANTIC_SCHOLAR_API_KEY=s2k-KbPklJRG5fASh9MUnasb3mibyyffIPPTukk2o3Sx

# GitHub API (for code search in prior work)
# Create token at: https://github.com/settings/tokens (scope: public_repo)
GITHUB_TOKEN=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

# Embeddings Provider: "local" (Xenova/transformers, free but slower) or "openai" (faster, needs API key)
EMBEDDING_PROVIDER=openai
OPENAI_API_KEY=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
OPENAI_EMBEDDING_MODEL=text-embedding-3-small

# Overleaf Git Integration (for Mode 2 - paper drafting)
# Create a blank Overleaf project, then "Menu > Git" to get Git URL
# Generate token at: https://www.overleaf.com/account/settings#api
OVERLEAF_GIT_URL=https://git@git.overleaf.com/6a652ad1eb76f187e2c5bef3
OVERLEAF_GIT_TOKEN=olp_2WGjipumAOA7KHG2nQtFtfo468lxy21DT2Pf

# Scimago Journal Quartile Lookup (optional)
# Download CSV from https://www.scimagojr.com/journalrank.php
# Place at ./data/scimago-quartiles.csv
SCIMAGO_QUARTILE_CSV=./data/scimago-quartiles.csv

# Memory Persistence
MEMORY_PERSIST_PATH=./data/memory.json
MEMORY_PERSIST_INTERVAL_MS=30000

# OAuth (optional - for authenticated MCP transport)
# OAUTH_REQUIRED=false
# OAUTH_CLIENT_ID=
# OAUTH_CLIENT_SECRET=
# JWKS_URI=
# TOKEN_INTROSPECTION_ENDPOINT=